# Application Settings
PORT=8090
ENVIRONMENT=Development
LOG_LEVEL=DEBUG
LOGGING_ENVIRONMENT=dev

# Database Settings
# Note: On macOS, PostgreSQL often uses your system username as the default superuser
# If 'postgres' role doesn't exist, use your system username
POSTGRES_DB_HOST=localhost
POSTGRES_DB_PORT=5432
POSTGRES_DB_USERNAME=your_username
POSTGRES_DB_PASSWORD=
POSTGRES_DB_NAME=postgres
POSTGRES_DB_SCHEMA=public

# Enterprise remote DB override (optional).
# When ENTERPRISE_DB_DIALECT is set, the app pre-activates this connection as the
# monitored database on startup; otherwise it falls back to the local PostgreSQL above.
# Never hardcode these in source — keep credentials here only.
# ENTERPRISE_DB_DIALECT=mysql
# ENTERPRISE_DB_HOST=127.0.0.1
# ENTERPRISE_DB_PORT=13306
# ENTERPRISE_DB_NAME=aidemo1
# ENTERPRISE_DB_USER=root
# ENTERPRISE_DB_PASSWORD=

# OpenAI-compatible Settings.
# base_url lets you point at any OpenAI-compatible provider (e.g. SiliconFlow).
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-ada-002

# Redis Settings
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
